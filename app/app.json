{
  "expo": {
    "name": "KidCog",
    "slug": "kidcog",
    "scheme": "kidcog",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F7F5F2"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.kidcog",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.example.kidcog",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6B4BB0"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "KidCog",
      "shortName": "KidCog",
      "themeColor": "#6B4BB0",
      "backgroundColor": "#FFF8EF"
    },
    "extra": {
      "apiBaseUrl": "http://localhost:4000"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication"
    ]
  }
}
