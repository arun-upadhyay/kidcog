EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Set to 1 once Facebook is switched on in Supabase (Authentication > Sign In / Providers).
EXPO_PUBLIC_FACEBOOK_SIGNIN=0
# Minutes without activity before a parent is signed out (0 turns it off).
EXPO_PUBLIC_IDLE_LOGOUT_MINUTES=30
# "Support this project" links in the ☰ menu (website only). Leave empty to hide.
# A Stripe Payment Link ("customer chooses price") and/or a PayPal link such as https://paypal.me/yourname
EXPO_PUBLIC_SUPPORT_STRIPE_URL=
EXPO_PUBLIC_SUPPORT_PAYPAL_URL=
# 1 = also show the support links in the iPhone and Android apps (default: website only)
EXPO_PUBLIC_SUPPORT_IN_APP=
# The website, for the privacy policy and account-deletion pages (the phone app links to these).
EXPO_PUBLIC_WEB_URL=https://kidcogvercelapp.vercel.app
# Email shown on those pages for privacy and deletion requests.
EXPO_PUBLIC_CONTACT_EMAIL=info@ritvikglobal.com

# Store links for the "Get the KidCog app" bar shown on phone web browsers.
# Leave empty until the app is live in that store; the bar only shows for the stores set.
EXPO_PUBLIC_APP_STORE_URL=
EXPO_PUBLIC_PLAY_STORE_URL=
