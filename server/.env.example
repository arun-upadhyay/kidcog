# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini
PORT=4000

# Supabase project settings. The service-role key belongs on the server only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Set to 1 to score open-ended answers with a local heuristic instead of calling
# OpenAI. Useful for development so you don't burn tokens on every test run.
USE_MOCK_GRADER=0

# Some models (the gpt-6 family) reject an explicit temperature and allow only
# their default. Set this to 1 ONLY if your model accepts one — grading then
# uses temperature 0, which makes repeat scoring of the same answers more
# consistent. Leave unset for gpt-6-*.
OPENAI_SUPPORTS_TEMPERATURE=0

# Speech-to-text model for spoken answers from young children.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Text-to-speech for reading questions to young children.
# Voices for gpt-4o-mini-tts: alloy, ash, ballad, coral, echo, fable, nova,
# onyx, sage, shimmer, verse, marin, cedar.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
