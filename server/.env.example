# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini
PORT=4000

# Supabase project settings. The service-role key belongs on the server only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Set to 1 to score open-ended answers with a local heuristic instead of calling
# OpenAI. Useful for development so you don't burn tokens on every test run.
USE_MOCK_GRADER=0

# Some models (the gpt-6 family) reject an explicit temperature and allow only
# their default. Set this to 1 ONLY if your model accepts one — grading then
# uses temperature 0, which makes repeat scoring of the same answers more
# consistent. Leave unset for gpt-6-*.
OPENAI_SUPPORTS_TEMPERATURE=0

# Speech-to-text model for spoken answers from young children.
# gpt-4o-mini-transcribe is faster than whisper-1 and half the price.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Text-to-speech for reading questions to young children.
# Voices for gpt-4o-mini-tts: alloy, ash, ballad, coral, echo, fable, nova,
# onyx, sage, shimmer, verse, marin, cedar.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# One model per job. Small, fast models are plenty for writing questions and
# scoring short answers; OPENAI_MODEL is only the fallback for any left unset.
OPENAI_QUESTION_MODEL=gpt-4o-mini
OPENAI_GRADE_MODEL=gpt-4o-mini
# The written note for the grown-up. Arrives a few seconds after the scores, so
# a bigger model here costs money but no waiting.
OPENAI_REPORT_MODEL=gpt-4o-mini

# Shared question bank (server/src/questionBank.ts). Rounds are picked from it
# instantly; the AI only writes new batches in the background.
QUESTION_BATCH_SIZE=8              # questions per background batch
QUESTION_BANK_MAX_PER_AGE=120      # most questions ever kept per category and age
QUESTION_BANK_LOW_WATER=12         # top up when a child has fewer unseen than this
QUESTION_DAILY_BATCH_LIMIT=300     # background batches per day (about $1 at gpt-4o-mini prices)
QUESTION_BACKGROUND_PARALLEL=2     # AI batches running at once
QUESTION_REVIEW=1                  # 0 skips the second "review" call per batch (cheaper, less checked)

# Make read-aloud audio for a round as soon as it starts (young children only),
# so "Listen" plays instantly. Each text is made once and kept in storage.
TTS_PREWARM=1

# Production only: the website address(es) allowed to call this server from a
# browser, comma-separated. Leave unset while developing.
# ALLOWED_ORIGINS=https://kidcog.ritvikglobal.com

# Where rounds get their questions.
#   files (default once server/questions/*.json exist): only the reviewed question
#         files, no AI writes questions. AI is still used to check spoken answers
#         and to write the parent's note.
#   ai:   the old behaviour — the AI keeps writing new questions into the bank.
# Draft or update the files with:  npm run draft-questions
# QUESTION_SOURCE=files

# Only for `npm run migrate` (runs supabase/migrations from the terminal). Not used by the app.
# Supabase → Connect → "Session pooler" connection string, with your database password.
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
